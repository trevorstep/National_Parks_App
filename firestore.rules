rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resource) {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId}/visitedParks/{parkCode} {
      allow read, write: if signedIn() && request.auth.uid == userId
        && parkCode.matches('^[a-z0-9]{4,5}$');
    }

    match /journalEntries/{entryId} {
      allow read, delete: if owns(resource);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.parkCode.matches('^[a-z0-9]{4,5}$')
        && request.resource.data.parkName is string
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 12000;
      allow update: if owns(resource)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.parkCode.matches('^[a-z0-9]{4,5}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 12000;
    }
  }
}
